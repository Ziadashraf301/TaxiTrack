# PostgreSQL (Airflow DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password123
CLICKHOUSE_DB=data_warehouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9005

# Airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres_airflow:5432/airflow
AIRFLOW_FERNET_KEY=fernet-key-here
AIRFLOW_DEFAULT_TIMEZONE=utc
AIRFLOW_LOAD_EXAMPLES=False

# SMTP Alerting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=True
SMTP_SSL=False
SMTP_USER=email@gmail.com
SMTP_PASSWORD=app_password
SMTP_MAIL_FROM=email@gmail.com
