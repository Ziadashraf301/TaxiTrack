# ==============================================================================
# TaxiTrack Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Core: MinIO S3 Object Storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Core: ClickHouse OLAP Data Warehouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password123
CLICKHOUSE_DB=data_warehouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9005

# Unified PostgreSQL (Shared by Airflow, MLflow, and Metabase)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Data Profile: Apache Airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW_FERNET_KEY=t_8Y9aZ4pQeQv7mX1uJ5wK3rT8yB6eN0pL9sR4vY7xM=
AIRFLOW_WEBSERVER_PORT=8080

# Data Profile: Metabase BI
METABASE_PORT=3000

# ML Profile: MLflow Credentials (runs on unified postgres instance)
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow123
MLFLOW_DB_NAME=mlflow

# ML Profile: MLflow Tracking Server
MLFLOW_PORT=5000

# ML Profile: Streamlit Dashboard UI
STREAMLIT_PORT=8501

# Monitoring Profile: Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
